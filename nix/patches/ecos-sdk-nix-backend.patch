diff --git a/mk/ecos-firmware.mk b/mk/ecos-firmware.mk
new file mode 100644
index 0000000..b50b049
--- /dev/null
+++ b/mk/ecos-firmware.mk
@@ -0,0 +1,283 @@
+.DEFAULT_GOAL := all
+
+ifndef ECOS_SDK_HOME
+$(error ECOS_SDK_HOME is not set)
+endif
+
+BOARD ?= c2
+PROJECT_DIR ?= $(CURDIR)
+BUILD_DIR ?= $(PROJECT_DIR)/build
+CONFIG_DIR ?= $(PROJECT_DIR)/.ecos-build/config
+DEFCONFIG ?= $(PROJECT_DIR)/configs/$(BOARD)_defconfig
+CROSS ?= riscv64-none-elf-
+FIRMWARE_NAME ?= retrosoc_fw
+COMPRESSED_MAP_ASSETS ?= 0
+PSRAM_RUNTIME_BYTES ?= 0
+
+PROJECT_DIR_ABS := $(abspath $(PROJECT_DIR))
+BUILD_DIR_ABS := $(abspath $(BUILD_DIR))
+CONFIG_DIR_ABS := $(abspath $(CONFIG_DIR))
+DEFCONFIG_ABS := $(abspath $(DEFCONFIG))
+MEMORY_REPORT := $(BUILD_DIR_ABS)/memory-report.txt
+SECTIONS_INFO := $(BUILD_DIR_ABS)/sections.info
+
+BOARD_MK := $(ECOS_SDK_HOME)/mk/boards/$(BOARD).mk
+ifeq ($(wildcard $(BOARD_MK)),)
+$(error Unsupported BOARD '$(BOARD)': missing $(BOARD_MK))
+endif
+include $(BOARD_MK)
+
+KCONFIG := $(ECOS_SDK_HOME)/tools/kconfig/Kconfig
+HOST_TOOLS_DIR := $(BUILD_DIR_ABS)/host-tools
+KCONFIG_WORK_DIR := $(HOST_TOOLS_DIR)/kconfig
+CONF := $(KCONFIG_WORK_DIR)/build/conf
+
+CC := $(CROSS)gcc
+CPP := $(CROSS)cpp
+OBJCOPY := $(CROSS)objcopy
+OBJDUMP := $(CROSS)objdump
+SED ?= sed
+AWK ?= awk
+
+ifeq ($(ECOS_INTERNAL_BUILD),1)
+-include $(CONFIG_DIR_ABS)/configs/.config
+endif
+
+CFLAGS := \
+  $(ARCH_CFLAGS) \
+  -Wl,-Bstatic,-T,$(BUILD_DIR_ABS)/retrosoc_sections.lds,--strip-debug \
+  -Wl,-Map=$(BUILD_DIR_ABS)/$(FIRMWARE_NAME).map,--cref \
+  -ffreestanding \
+  -nostdlib
+
+LDS_CPPFLAGS :=
+
+ifdef CONFIG_LINK_RAM_REGION_SRAM
+CFLAGS += -DCONFIG_LINK_RAM_REGION_SRAM
+LDS_CPPFLAGS += -DCONFIG_LINK_RAM_REGION_SRAM
+endif
+
+ifdef CONFIG_LINK_RAM_REGION_PSRAM
+CFLAGS += -DCONFIG_LINK_RAM_REGION_PSRAM
+LDS_CPPFLAGS += -DCONFIG_LINK_RAM_REGION_PSRAM
+endif
+
+ifdef CONFIG_BUILD_OPT_FLAGS
+CFLAGS += $(subst ",,$(CONFIG_BUILD_OPT_FLAGS))
+else
+CFLAGS += -Os
+endif
+
+ifdef CONFIG_BUILD_DEBUG
+CFLAGS += -g -DDEBUG
+endif
+
+CFLAGS += $(EXTRA_CFLAGS)
+
+SDK_C_SRCS := $(foreach dir,$(SDK_COMPONENT_DIRS),$(shell find $(dir) -name "*.c"))
+SDK_C_SRCS += $(foreach dir,$(SDK_DEVICE_DIRS),$(shell find $(dir) -name "*.c"))
+
+SDK_INC_DIRS := $(foreach dir,$(SDK_COMPONENT_DIRS),$(shell find $(dir) -type d))
+SDK_INC_DIRS += $(foreach dir,$(SDK_DEVICE_DIRS),$(shell find $(dir) -type d))
+
+SRC_PATH := \
+  $(BOARD_STARTUP) \
+  $(PROJECT_DIR_ABS)/firmware/main.c \
+  $(PROJECT_DIR_ABS)/firmware/mc_log.c \
+  $(PROJECT_DIR_ABS)/firmware/mc_link_session.c \
+  $(PROJECT_DIR_ABS)/firmware/platform_uart0.c \
+  $(PROJECT_DIR_ABS)/firmware/platform_psram.c \
+  $(PROJECT_DIR_ABS)/firmware/platform_ecos.c \
+  $(PROJECT_DIR_ABS)/firmware/platform_compat.c \
+  $(shell find $(PROJECT_DIR_ABS)/core/src -name "*.c") \
+  $(SDK_C_SRCS) \
+  $(SDK_ASM_SRCS)
+
+ifeq ($(COMPRESSED_MAP_ASSETS),1)
+SRC_PATH += $(PROJECT_DIR_ABS)/core/generated/mc_world_compressed_assets.c
+endif
+
+CFLAGS += \
+  -I$(PROJECT_DIR_ABS) \
+  -I$(PROJECT_DIR_ABS)/firmware \
+  -I$(PROJECT_DIR_ABS)/core/include \
+  -I$(CONFIG_DIR_ABS) \
+  -I$(BOARD_INCLUDE) \
+  $(addprefix -I,$(SDK_INC_DIRS))
+
+ifeq ($(COMPRESSED_MAP_ASSETS),1)
+CFLAGS += -I$(PROJECT_DIR_ABS)/core/generated
+endif
+
+.PHONY: all configure firmware memory-report clean check-inputs
+
+all: configure
+	@$(MAKE) --no-print-directory -f $(ECOS_SDK_HOME)/mk/ecos-firmware.mk \
+		ECOS_INTERNAL_BUILD=1 \
+		ECOS_SDK_HOME="$(ECOS_SDK_HOME)" \
+		PROJECT_DIR="$(PROJECT_DIR_ABS)" \
+		BUILD_DIR="$(BUILD_DIR_ABS)" \
+		CONFIG_DIR="$(CONFIG_DIR_ABS)" \
+		DEFCONFIG="$(DEFCONFIG_ABS)" \
+		BOARD="$(BOARD)" \
+		CROSS="$(CROSS)" \
+		FIRMWARE_NAME="$(FIRMWARE_NAME)" \
+		COMPRESSED_MAP_ASSETS="$(COMPRESSED_MAP_ASSETS)" \
+		PSRAM_RUNTIME_BYTES="$(PSRAM_RUNTIME_BYTES)" \
+		firmware
+
+check-inputs:
+	@case "$(PSRAM_RUNTIME_BYTES)" in \
+		""|*[!0-9]*) echo "PSRAM_RUNTIME_BYTES must be an unsigned decimal byte count" >&2; exit 1 ;; \
+	esac
+	@test -f "$(PROJECT_DIR_ABS)/firmware/main.c" || \
+		(echo "Missing project source: $(PROJECT_DIR_ABS)/firmware/main.c" >&2; exit 1)
+	@test -f "$(DEFCONFIG_ABS)" || \
+		(echo "Missing defconfig: $(DEFCONFIG_ABS)" >&2; exit 1)
+	@test -f "$(BOARD_STARTUP)" || \
+		(echo "Missing board startup: $(BOARD_STARTUP)" >&2; exit 1)
+	@test -f "$(BOARD_LDS)" || \
+		(echo "Missing board linker script: $(BOARD_LDS)" >&2; exit 1)
+
+$(KCONFIG_WORK_DIR)/Makefile:
+	@mkdir -p "$(HOST_TOOLS_DIR)"
+	@rm -rf "$(KCONFIG_WORK_DIR)"
+	@cp -R "$(ECOS_SDK_HOME)/tools/kconfig" "$(KCONFIG_WORK_DIR)"
+	@chmod -R u+w "$(KCONFIG_WORK_DIR)"
+
+$(CONF): $(KCONFIG_WORK_DIR)/Makefile
+	@$(MAKE) --no-print-directory -C "$(KCONFIG_WORK_DIR)" \
+		ECOS_SDK_HOME="$(ECOS_SDK_HOME)" \
+		BUILD_DIR="$(KCONFIG_WORK_DIR)/build" \
+		NAME=conf
+
+configure: check-inputs $(CONF)
+	@mkdir -p "$(CONFIG_DIR_ABS)/configs" "$(CONFIG_DIR_ABS)/generated" "$(CONFIG_DIR_ABS)/config"
+	@cd "$(CONFIG_DIR_ABS)" && \
+		KCONFIG_CONFIG="$(CONFIG_DIR_ABS)/configs/.config" \
+		KCONFIG_AUTOCONFIG="$(CONFIG_DIR_ABS)/config/auto.conf" \
+		KCONFIG_AUTOHEADER="$(CONFIG_DIR_ABS)/generated/autoconf.h" \
+		"$(CONF)" -s --defconfig="$(DEFCONFIG_ABS)" "$(KCONFIG)"
+	@cd "$(CONFIG_DIR_ABS)" && \
+		KCONFIG_CONFIG="$(CONFIG_DIR_ABS)/configs/.config" \
+		KCONFIG_AUTOCONFIG="$(CONFIG_DIR_ABS)/config/auto.conf" \
+		KCONFIG_AUTOHEADER="$(CONFIG_DIR_ABS)/generated/autoconf.h" \
+		"$(CONF)" -s --syncconfig "$(KCONFIG)"
+
+firmware: check-inputs
+	@test -f "$(CONFIG_DIR_ABS)/generated/autoconf.h" || \
+		(echo "Missing generated config: run make configure first" >&2; exit 1)
+	@echo "Building $(FIRMWARE_NAME) for $(BOARD_NAME)..."
+	@mkdir -p "$(BUILD_DIR_ABS)"
+	@$(CPP) -P $(LDS_CPPFLAGS) -o "$(BUILD_DIR_ABS)/retrosoc_sections.lds" "$(BOARD_LDS)"
+	@$(CC) $(CFLAGS) -o "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME)" $(SRC_PATH)
+	@$(OBJCOPY) -O verilog "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME)" "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME).hex"
+	@$(SED) -i 's/@30000000/@00000000/g' "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME).hex"
+	@$(OBJCOPY) -O binary "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME)" "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME).bin"
+	@$(OBJDUMP) -d "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME)" > "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME).txt"
+	@$(MAKE) --no-print-directory -f "$(ECOS_SDK_HOME)/mk/ecos-firmware.mk" memory-report
+	@echo "Done: $(BUILD_DIR_ABS)/$(FIRMWARE_NAME)"
+
+memory-report: check-inputs
+	@for report_range in \
+		REPORT_FLASH_START="$(REPORT_FLASH_START)" \
+		REPORT_FLASH_SIZE="$(REPORT_FLASH_SIZE)" \
+		REPORT_SRAM_START="$(REPORT_SRAM_START)" \
+		REPORT_SRAM_SIZE="$(REPORT_SRAM_SIZE)" \
+		REPORT_PSRAM_START="$(REPORT_PSRAM_START)" \
+		REPORT_PSRAM_SIZE="$(REPORT_PSRAM_SIZE)"; do \
+		report_name=$${report_range%%=*}; \
+		report_value=$${report_range#*=}; \
+		if [ -z "$$report_value" ]; then \
+			echo "BOARD $(BOARD_NAME) does not define memory report ranges" >&2; exit 1; \
+		fi; \
+		case "$$report_value" in \
+			0x*|0X*) \
+				report_digits=$${report_value#0x}; report_digits=$${report_digits#0X}; \
+				case "$$report_digits" in ""|*[!0-9A-Fa-f]*) echo "$$report_name must be a decimal or hexadecimal value" >&2; exit 1 ;; esac ;; \
+			*) \
+				case "$$report_value" in *[!0-9]*) echo "$$report_name must be a decimal or hexadecimal value" >&2; exit 1 ;; esac ;; \
+		esac; \
+	done
+	@test -f "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME)" || \
+		(echo "Missing firmware ELF: $(BUILD_DIR_ABS)/$(FIRMWARE_NAME)" >&2; exit 1)
+	@$(OBJDUMP) -h "$(BUILD_DIR_ABS)/$(FIRMWARE_NAME)" > "$(SECTIONS_INFO)"
+	@$(AWK) \
+		-v flash_start="$(REPORT_FLASH_START)" \
+		-v flash_size="$(REPORT_FLASH_SIZE)" \
+		-v sram_start="$(REPORT_SRAM_START)" \
+		-v sram_size="$(REPORT_SRAM_SIZE)" \
+		-v psram_start="$(REPORT_PSRAM_START)" \
+		-v psram_size="$(REPORT_PSRAM_SIZE)" \
+		-v psram_runtime="$(PSRAM_RUNTIME_BYTES)" '\
+	function fmt(bytes, sign) { \
+		sign = ""; \
+		if (bytes < 0) { sign = "-"; bytes = -bytes; } \
+		if (bytes < 1024) return sprintf("%s%d B", sign, bytes); \
+		if (bytes < 1048576) return sprintf("%s%.2f KB", sign, bytes / 1024); \
+		return sprintf("%s%.2f MB", sign, bytes / 1048576); \
+	} \
+	function account_allocated() { \
+		if ((candidate_name == ".text" || candidate_name == ".data") && candidate_lma >= flash_start && candidate_lma < flash_end) { \
+			if (candidate_name == ".text") text_size = candidate_size; \
+			if (candidate_name == ".data") data_size = candidate_size; \
+		} \
+		if (candidate_vma >= sram_start && candidate_vma < sram_end) { \
+			sram_sections += candidate_size; \
+			if (candidate_name == ".data") sram_data += candidate_size; \
+			if (candidate_name == ".bss") sram_bss += candidate_size; \
+		} \
+		if (candidate_vma >= psram_start && candidate_vma < psram_end) { \
+			psram_sections += candidate_size; \
+		} \
+	} \
+	function row(name, used, total, free) { \
+		free = total - used; \
+		printf "%-15s %-15s %-15s %-10s %-15s\n", name, fmt(used), fmt(total), sprintf("%.2f%%", (used / total) * 100), fmt(free); \
+	} \
+	BEGIN { \
+		flash_start = strtonum(flash_start); \
+		flash_total = strtonum(flash_size); \
+		flash_end = flash_start + flash_total; \
+		sram_start = strtonum(sram_start); \
+		sram_total = strtonum(sram_size); \
+		sram_end = sram_start + sram_total; \
+		psram_start = strtonum(psram_start); \
+		psram_total = strtonum(psram_size); \
+		psram_end = psram_start + psram_total; \
+		psram_runtime += 0; \
+	} \
+	/^[[:space:]]*[0-9]+[[:space:]]/ { \
+		candidate_name = $$2; \
+		candidate_size = strtonum("0x" $$3); \
+		candidate_vma = strtonum("0x" $$4); \
+		candidate_lma = strtonum("0x" $$5); \
+		next; \
+	} \
+	candidate_name != "" { \
+		if ($$0 ~ /(^|[[:space:],])ALLOC([[:space:],]|$$)/) account_allocated(); \
+		candidate_name = ""; \
+	} \
+	END { \
+		flash_used = text_size + data_size; \
+		psram_used = psram_sections + psram_runtime; \
+		print "------------------------------------------------------------------------------"; \
+		print "Memory Usage:"; \
+		print "--------------------------------------------------------------------------"; \
+		printf "%-15s %-15s %-15s %-10s %-15s\n", "Memory Region", "Used Size", "Total Size", "Usage %", "Free"; \
+		print "--------------------------------------------------------------------------"; \
+		row("FLASH", flash_used, flash_total); \
+		row("SRAM", sram_sections, sram_total); \
+		row("PSRAM", psram_used, psram_total); \
+		print "--------------------------------------------------------------------------"; \
+		print "RAM Details:"; \
+		print "  SRAM .data: " fmt(sram_data); \
+		print "  SRAM .bss:  " fmt(sram_bss); \
+		print "  PSRAM sections: " fmt(psram_sections); \
+		print "  PSRAM runtime:  " fmt(psram_runtime); \
+		print "------------------------------------------------------------------------------"; \
+	}' "$(SECTIONS_INFO)" > "$(MEMORY_REPORT)"
+	@cat "$(MEMORY_REPORT)"
+
+clean:
+	rm -rf "$(BUILD_DIR_ABS)" "$(CONFIG_DIR_ABS)"
